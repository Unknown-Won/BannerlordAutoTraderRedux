<Brushes>
  <Brush Name="AT.Divider" >
    <Layers>
      <BrushLayer Name="Default" Sprite="GradientDivider_9"/>
    </Layers>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Default" AlphaFactor="0.9" Color="#FFEEDDFF" />
      </Style>
    </Styles>
  </Brush>

  <!-- Number box next to a slider (copied from the game's CustomBattle.SliderValue brushes) -->
  <Brush Name="AT.SliderValue.Input">
    <Layers>
      <BrushLayer Name="Default" Sprite="frame_small_9" ExtendTop="3" ExtendBottom="3"/>
    </Layers>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Default" AlphaFactor="0.7" ColorFactor="1" />
      </Style>
      <Style Name="Hovered">
        <BrushLayer Name="Default" AlphaFactor="0.9" ColorFactor="1.2" />
      </Style>
      <Style Name="Pressed">
        <BrushLayer Name="Default" AlphaFactor="0.8" />
      </Style>
      <Style Name="Selected">
        <BrushLayer Name="Default" AlphaFactor="1" />
      </Style>
      <Style Name="Disabled">
        <BrushLayer Name="Default" AlphaFactor="0.5" ColorFactor="0.7" />
      </Style>
    </Styles>
  </Brush>

  <Brush Name="AT.SliderValue.Text" Font="FiraSansExtraCondensed-Regular" TextHorizontalAlignment="Center" TextVerticalAlignment="Center">
    <Styles>
      <Style Name="Default" FontColor="#F7C895FF" TextGlowColor="#FFFFFF00" TextOutlineColor="#FFFFFF00" TextOutlineAmount="0" TextGlowRadius="0" TextBlur="0" FontSize="22" />
      <Style Name="Hovered" FontColor="#FFE2B8FF" TextGlowColor="#FFFFFF00" TextOutlineColor="#FFFFFF00" TextOutlineAmount="0" TextGlowRadius="0" TextBlur="0" FontSize="22" />
      <Style Name="Pressed" FontColor="#FFB96EFF" TextGlowColor="#FFFFFF00" TextOutlineColor="#FFFFFF00" TextOutlineAmount="0" TextGlowRadius="0" TextBlur="0" FontSize="22" />
      <Style Name="Disabled" FontColor="#D5B88B00" TextGlowColor="#00000000" />
    </Styles>
  </Brush>

  <!-- Profile name box (like the game's SaveLoad.Search.InputText, smaller) -->
  <Brush Name="AT.ProfileName.Text" Font="FiraSansExtraCondensed-Regular" TextHorizontalAlignment="Left" TextVerticalAlignment="Center">
    <Styles>
      <Style Name="Default" FontColor="#F9EAD2FF" TextGlowColor="#000000FF" TextOutlineColor="#000000FF" TextOutlineAmount="0" TextGlowRadius="0" TextBlur="0" FontSize="24" />
    </Styles>
  </Brush>
</Brushes>
